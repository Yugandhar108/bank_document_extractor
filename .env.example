# Copy this file to bank_document_extractor/.venv/.env.
# Add one real provider key. The application searches all provider settings
# and uses the requested provider first, then another available provider.

# Optional preference. Leave blank to use the first available key.
LLM_PROVIDER=

# Optional shared model override.
LLM_MODEL=

OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=
OPENAI_BASE_URL=

GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL=
GEMINI_BASE_URL=

GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=
GROQ_BASE_URL=

OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=

HUGGINGFACE_API_KEY=replace-with-your-huggingface-key
HUGGINGFACE_MODEL=
HUGGINGFACE_BASE_URL=

INPUT_DIRECTORY=data/input
OUTPUT_DIRECTORY=data/output
MEMORY_DIRECTORY=storage
